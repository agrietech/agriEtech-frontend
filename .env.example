# Backend API Configuration
API_BASE_URL=http://localhost:5000/api/v1
SOCKET_BASE_URL=http://localhost:5000

# Map Configuration
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Environment Configuration
APP_ENV=development
DEBUG_MODE=true

# API Timeouts (milliseconds)
API_TIMEOUT=30000
LONG_API_TIMEOUT=120000

# Caching Configuration
CACHE_ENABLED=true
CACHE_DURATION_SHORT=300000
CACHE_DURATION_MEDIUM=1800000
CACHE_DURATION_LONG=3600000

# Real-time Configuration
SOCKET_RECONNECT=true
SOCKET_RECONNECT_ATTEMPTS=5
SOCKET_RECONNECT_DELAY=1000

# Firebase Configuration (for production)
FIREBASE_PROJECT_ID=agrietech-ewa
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here

# Feature Flags
ENABLE_OFFLINE_SYNC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BACKGROUND_SYNC=true
ENABLE_BIOMETRIC_AUTH=false

# Image Upload Configuration
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Localization
DEFAULT_LANGUAGE=en
FALLBACK_LANGUAGE=en
