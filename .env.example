# AgriEtech Frontend Environment Configuration
# Copy this file to .env and adjust values as needed.

# API Base URL (default is production for release mode, or localhost for debug mode)
API_BASE_URL=https://agrietech.onrender.com/api/v1
SOCKET_BASE_URL=https://agrietech.onrender.com

# Environment (development | staging | production)
APP_ENV=development
DEBUG_MODE=true

# API Timeouts in milliseconds
API_TIMEOUT=30000
LONG_API_TIMEOUT=120000

# Map Configuration
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Caching Configuration
CACHE_ENABLED=true
CACHE_DURATION_SHORT=300000
CACHE_DURATION_MEDIUM=1800000
CACHE_DURATION_LONG=3600000

# Socket Configuration
SOCKET_RECONNECT=true
SOCKET_RECONNECT_ATTEMPTS=5
SOCKET_RECONNECT_DELAY=1000

# Firebase Configuration
FIREBASE_PROJECT_ID=agrietech-ewa
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# Feature Flags
ENABLE_OFFLINE_SYNC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BACKGROUND_SYNC=true
ENABLE_BIOMETRIC_AUTH=false

# Media Configuration
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Localization
DEFAULT_LANGUAGE=am
FALLBACK_LANGUAGE=en
