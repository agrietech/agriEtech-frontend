<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for local development & physical device testing -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Render backend domain -->
        <domain includeSubdomains="true">agrietech.onrender.com</domain>
        <domain includeSubdomains="true">onrender.com</domain>

        <!-- Local IPs & Emulators -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.228.162.78</domain>
        <domain includeSubdomains="true">10.78.97.164</domain>
    </domain-config>
</network-security-config>
